# Public app download URLs. Leave blank to keep the demo links disabled.
NEXT_PUBLIC_IOS_APP_URL=
NEXT_PUBLIC_ANDROID_APP_URL=

# Replace with the production site URL before deploying.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Durable commerce storage (configure after choosing Vercel KV / Upstash).
# Keep these server-only: never expose them with NEXT_PUBLIC_.
KV_REST_API_URL=
KV_REST_API_TOKEN=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
COMMERCE_STORE_PREFIX=cowin-commerce

# Oceanpayment embedded checkout.
# Add real merchant values only in Vercel Production/Preview environment variables.
# Never commit credentials, terminal numbers, secret codes or API keys.
OCEANPAYMENT_ACCOUNT=
OCEANPAYMENT_CARD_TERMINAL=
OCEANPAYMENT_CARD_SECURE_CODE=
OCEANPAYMENT_CARD_PUBLIC_KEY=
OCEANPAYMENT_WALLET_TERMINAL=
OCEANPAYMENT_WALLET_SECURE_CODE=
OCEANPAYMENT_WALLET_PUBLIC_KEY=
OCEANPAYMENT_GATEWAY_URL=https://secure.oceanpayment.com/gateway/service/test
OCEANPAYMENT_ENV=test
PAYMENT_CURRENCY=USD

# Future warehouse/ERP inventory sync. Do not enable until endpoint, authentication
# and stock-reservation behavior are agreed with the warehouse provider.
INVENTORY_SYNC_ENABLED=false
INVENTORY_API_URL=
INVENTORY_API_TOKEN=
