# Public app download URLs. Leave blank to keep the demo links disabled.
NEXT_PUBLIC_IOS_APP_URL=
NEXT_PUBLIC_ANDROID_APP_URL=

# Replace with the production site URL before deploying.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Durable commerce storage (configure after choosing Vercel KV / Upstash).
# Keep these server-only: never expose them with NEXT_PUBLIC_.
KV_REST_API_URL=
KV_REST_API_TOKEN=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
COMMERCE_STORE_PREFIX=cowin-commerce

# Oceanpayment embedded checkout.
# Add real merchant values only in Vercel Production/Preview environment variables.
# Never commit credentials, terminal numbers, secret codes or API keys.
OCEANPAYMENT_ACCOUNT=
OCEANPAYMENT_CARD_TERMINAL=
OCEANPAYMENT_CARD_SECURE_CODE=
OCEANPAYMENT_CARD_PUBLIC_KEY=
OCEANPAYMENT_WALLET_TERMINAL=
OCEANPAYMENT_WALLET_SECURE_CODE=
OCEANPAYMENT_WALLET_PUBLIC_KEY=
OCEANPAYMENT_GATEWAY_URL=https://secure.oceanpayment.com/gateway/service/test
OCEANPAYMENT_ENV=test
OCEANPAYMENT_NOTICE_URL=https://cowinglasses.com/api/webhooks/oceanpayment
# Private, one-token USD 0.01 verification checkout. Keep disabled unless a payment
# verification is actively required; never place this token in client-side config.
OCEANPAYMENT_TEST_PAYMENTS_ENABLED=false
OCEANPAYMENT_TEST_ORDER_TOKEN=
PAYMENT_CURRENCY=USD

# Future warehouse/ERP inventory sync. Do not enable until endpoint, authentication
# and stock-reservation behavior are agreed with the warehouse provider.
INVENTORY_SYNC_ENABLED=false
INVENTORY_API_URL=
INVENTORY_API_TOKEN=

# COWIN Glasses 后台 / Neon PostgreSQL。仅供服务端使用，绝不加 NEXT_PUBLIC_ 前缀。
# Production 请使用 Neon 提供的 pooled connection string；Preview/Development 使用独立数据库分支。
DATABASE_URL=
ANALYTICS_VISITOR_SECRET=请使用至少32位的随机服务端密钥，用于将第一方匿名访客标识安全哈希后存储。
ANALYTICS_IP_ENCRYPTION_KEY=可选：64位十六进制随机密钥；未配置时会从现有 AUTH_SECRET 派生加密密钥，原始IP仅加密保存30天。
CRON_SECRET=生产环境必填：Vercel Cron 调用流量汇总和 News 自动化端点时使用的随机密钥。

# News 自动发布。生产默认使用 Vercel OIDC 访问 AI Gateway；也可配置 OpenAI 或 AI Gateway API Key。
NEWS_AUTOMATION_PUBLISH_MODE=auto
NEWS_AUTOMATION_CONTENT_MODEL=openai/gpt-5.4
OPENAI_API_KEY=
AI_GATEWAY_API_KEY=
# 可选：启用后把新文章 URL 提交给 Bing/IndexNow。不要把密钥放入 NEXT_PUBLIC_ 变量。
INDEXNOW_KEY=

# 管理员认证。AUTH_SECRET 请用安全随机值；初始密码只用于首次执行 db:seed，随后应删除。
AUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000
ADMIN_BOOTSTRAP_EMAIL=
ADMIN_BOOTSTRAP_NAME=COWIN Glasses 超级管理员
ADMIN_BOOTSTRAP_PASSWORD=

# 对象存储。未配置时媒体库只显示配置引导，不允许伪造上传成功。
STORAGE_PROVIDER=
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_BASE_URL=

# 支付适配层。当前保留 Oceanpayment 变量；前海支付等待服务商文档与正式凭据后再启用。
PAYMENT_PROVIDER=oceanpayment
PAYMENT_WEBHOOK_SECRET=
QIANHAI_MERCHANT_ID=
QIANHAI_GATEWAY_URL=
QIANHAI_SECRET_KEY=
QIANHAI_WEBHOOK_SECRET=

# 物流适配层。提供 API、Webhook 签名规则后再开启真实发货与追踪。
LOGISTICS_PROVIDER=
LOGISTICS_API_URL=
LOGISTICS_API_TOKEN=
LOGISTICS_WEBHOOK_SECRET=

# 邮件 / 短信通知适配层，覆盖下单、支付、发货、退款、售后和弃购提醒。
EMAIL_PROVIDER=
SMTP_HOST=
SMTP_PORT=
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
SMS_PROVIDER=
SMS_API_URL=
SMS_API_TOKEN=

# 渠道连接配置。均仅在服务端 Vercel 环境变量保存。
META_APP_ID=
META_APP_SECRET=
META_WEBHOOK_VERIFY_TOKEN=
GOOGLE_SEARCH_CONSOLE_SERVICE_ACCOUNT_JSON=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# Generic non-Oceanpayment webhooks: POST raw JSON to /api/webhooks/{provider} with
# x-cowin-signature = HMAC-SHA256(raw request body, provider webhook secret)
# and x-provider-event-id = provider's immutable event ID. Oceanpayment posts signed XML
# to /api/webhooks/oceanpayment and uses OCEANPAYMENT_CARD_SECURE_CODE for verification.
