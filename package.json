{
  "name": "cowin-glasses",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "tsx scripts/vercel-bootstrap.ts && tsx scripts/news-automation-self-test.ts && next build --webpack",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test src/lib/news/logic.test.ts src/config/shipping.test.ts src/lib/seo/indexability.test.ts src/lib/admin/date-range.test.ts src/lib/admin/server-action-exports.test.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:bootstrap": "tsx scripts/vercel-bootstrap.ts",
    "db:catalog:seed": "tsx scripts/catalog-seed.ts",
    "db:seed": "tsx src/db/seed.ts",
    "news:self-test": "tsx scripts/news-automation-self-test.ts",
    "commerce:test-cleanup": "tsx scripts/cleanup-test-commerce-data.ts",
    "search-console:submit": "tsx scripts/google-search-console-submit.ts"
  },
  "dependencies": {
    "@tailwindcss/postcss": "latest",
    "@vercel/oidc": "3.8.5",
    "bcryptjs": "^3.0.3",
    "clsx": "latest",
    "drizzle-orm": "^0.45.2",
    "lucide-react": "latest",
    "next": "^16.4.5",
    "next-auth": "^4.24.15",
    "postgres": "^3.4.9",
    "react": "latest",
    "react-dom": "latest",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9.39.1",
    "eslint-config-next": "^16.4.5",
    "tailwindcss": "latest",
    "tsx": "^4.23.12",
    "typescript": "^5.9.3"
  }
}
